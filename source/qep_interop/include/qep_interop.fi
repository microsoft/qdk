! Include in the specification part of a free-form Fortran program or module.
interface
    ! Replaces the backend with fresh state selected by a NUL-terminated name.
    subroutine qdk_init(backend) bind(C, name="qdk_init")
        use, intrinsic :: iso_c_binding, only: c_char
        character(kind=c_char), intent(in) :: backend(*)
    end subroutine qdk_init

    ! Flushes pending instructions and saves profiling data to a NUL-terminated UTF-8 path.
    subroutine qdk_save_profile(path) bind(C, name="qdk_save_profile")
        use, intrinsic :: iso_c_binding, only: c_char
        character(kind=c_char), intent(in) :: path(*)
    end subroutine qdk_save_profile

    ! Applies a doubly controlled X gate.
    subroutine qdk_ccx(control0, control1, target) bind(C, name="qdk_ccx")
        use, intrinsic :: iso_c_binding, only: c_size_t
        integer(c_size_t), value :: control0, control1, target
    end subroutine qdk_ccx

    ! Applies a controlled X gate.
    subroutine qdk_cx(control, target) bind(C, name="qdk_cx")
        use, intrinsic :: iso_c_binding, only: c_size_t
        integer(c_size_t), value :: control, target
    end subroutine qdk_cx

    ! Applies a controlled Y gate.
    subroutine qdk_cy(control, target) bind(C, name="qdk_cy")
        use, intrinsic :: iso_c_binding, only: c_size_t
        integer(c_size_t), value :: control, target
    end subroutine qdk_cy

    ! Applies a controlled Z gate.
    subroutine qdk_cz(control, target) bind(C, name="qdk_cz")
        use, intrinsic :: iso_c_binding, only: c_size_t
        integer(c_size_t), value :: control, target
    end subroutine qdk_cz

    ! Rotates a qubit around X by an angle in radians.
    subroutine qdk_rx(qubit_id, angle) bind(C, name="qdk_rx")
        use, intrinsic :: iso_c_binding, only: c_size_t, c_double
        integer(c_size_t), value :: qubit_id
        real(c_double), value :: angle
    end subroutine qdk_rx

    ! Applies an XX rotation by an angle in radians.
    subroutine qdk_rxx(qubit0, qubit1, angle) bind(C, name="qdk_rxx")
        use, intrinsic :: iso_c_binding, only: c_size_t, c_double
        integer(c_size_t), value :: qubit0, qubit1
        real(c_double), value :: angle
    end subroutine qdk_rxx

    ! Rotates a qubit around Y by an angle in radians.
    subroutine qdk_ry(qubit_id, angle) bind(C, name="qdk_ry")
        use, intrinsic :: iso_c_binding, only: c_size_t, c_double
        integer(c_size_t), value :: qubit_id
        real(c_double), value :: angle
    end subroutine qdk_ry

    ! Applies a YY rotation by an angle in radians.
    subroutine qdk_ryy(qubit0, qubit1, angle) bind(C, name="qdk_ryy")
        use, intrinsic :: iso_c_binding, only: c_size_t, c_double
        integer(c_size_t), value :: qubit0, qubit1
        real(c_double), value :: angle
    end subroutine qdk_ryy

    ! Rotates a qubit around Z by an angle in radians.
    subroutine qdk_rz(qubit_id, angle) bind(C, name="qdk_rz")
        use, intrinsic :: iso_c_binding, only: c_size_t, c_double
        integer(c_size_t), value :: qubit_id
        real(c_double), value :: angle
    end subroutine qdk_rz

    ! Applies a ZZ rotation by an angle in radians.
    subroutine qdk_rzz(qubit0, qubit1, angle) bind(C, name="qdk_rzz")
        use, intrinsic :: iso_c_binding, only: c_size_t, c_double
        integer(c_size_t), value :: qubit0, qubit1
        real(c_double), value :: angle
    end subroutine qdk_rzz

    ! Applies a Hadamard gate.
    subroutine qdk_h(qubit_id) bind(C, name="qdk_h")
        use, intrinsic :: iso_c_binding, only: c_size_t
        integer(c_size_t), value :: qubit_id
    end subroutine qdk_h

    ! Applies an S phase gate.
    subroutine qdk_s(qubit_id) bind(C, name="qdk_s")
        use, intrinsic :: iso_c_binding, only: c_size_t
        integer(c_size_t), value :: qubit_id
    end subroutine qdk_s

    ! Applies the adjoint of an S phase gate.
    subroutine qdk_sadj(qubit_id) bind(C, name="qdk_sadj")
        use, intrinsic :: iso_c_binding, only: c_size_t
        integer(c_size_t), value :: qubit_id
    end subroutine qdk_sadj

    ! Applies a square-root X gate.
    subroutine qdk_sx(qubit_id) bind(C, name="qdk_sx")
        use, intrinsic :: iso_c_binding, only: c_size_t
        integer(c_size_t), value :: qubit_id
    end subroutine qdk_sx

    ! Applies a T phase gate.
    subroutine qdk_t(qubit_id) bind(C, name="qdk_t")
        use, intrinsic :: iso_c_binding, only: c_size_t
        integer(c_size_t), value :: qubit_id
    end subroutine qdk_t

    ! Applies the adjoint of a T phase gate.
    subroutine qdk_tadj(qubit_id) bind(C, name="qdk_tadj")
        use, intrinsic :: iso_c_binding, only: c_size_t
        integer(c_size_t), value :: qubit_id
    end subroutine qdk_tadj

    ! Applies an X gate.
    subroutine qdk_x(qubit_id) bind(C, name="qdk_x")
        use, intrinsic :: iso_c_binding, only: c_size_t
        integer(c_size_t), value :: qubit_id
    end subroutine qdk_x

    ! Applies a Y gate.
    subroutine qdk_y(qubit_id) bind(C, name="qdk_y")
        use, intrinsic :: iso_c_binding, only: c_size_t
        integer(c_size_t), value :: qubit_id
    end subroutine qdk_y

    ! Applies a Z gate.
    subroutine qdk_z(qubit_id) bind(C, name="qdk_z")
        use, intrinsic :: iso_c_binding, only: c_size_t
        integer(c_size_t), value :: qubit_id
    end subroutine qdk_z

    ! Swaps two qubits.
    subroutine qdk_swap(qubit0, qubit1) bind(C, name="qdk_swap")
        use, intrinsic :: iso_c_binding, only: c_size_t
        integer(c_size_t), value :: qubit0, qubit1
    end subroutine qdk_swap

    ! Resets a qubit to zero.
    subroutine qdk_reset(qubit_id) bind(C, name="qdk_reset")
        use, intrinsic :: iso_c_binding, only: c_size_t
        integer(c_size_t), value :: qubit_id
    end subroutine qdk_reset

    ! Measures in Z and stores the outcome in a result register.
    subroutine qdk_mz_store(qubit_id, result_id) bind(C, name="qdk_mz_store")
        use, intrinsic :: iso_c_binding, only: c_size_t
        integer(c_size_t), value :: qubit_id, result_id
    end subroutine qdk_mz_store

    ! Measures in Z, stores the outcome, and resets the qubit.
    subroutine qdk_mz_store_reset(qubit_id, result_id) bind(C, name="qdk_mz_store_reset")
        use, intrinsic :: iso_c_binding, only: c_size_t
        integer(c_size_t), value :: qubit_id, result_id
    end subroutine qdk_mz_store_reset

    ! Reads a stored result: 0 = zero, 1 = one, 2 = backend error.
    function qdk_read_result(result_id) bind(C, name="qdk_read_result") result(outcome)
        use, intrinsic :: iso_c_binding, only: c_size_t
        integer(c_size_t), value :: result_id
        integer(c_size_t) :: outcome
    end function qdk_read_result

    ! Measures in Z: 0 = zero, 1 = one, 2 = backend error.
    function qdk_mz(qubit_id) bind(C, name="qdk_mz") result(outcome)
        use, intrinsic :: iso_c_binding, only: c_size_t
        integer(c_size_t), value :: qubit_id
        integer(c_size_t) :: outcome
    end function qdk_mz

    ! Measures in Z and resets: 0 = zero, 1 = one, 2 = backend error.
    function qdk_mz_reset(qubit_id) bind(C, name="qdk_mz_reset") result(outcome)
        use, intrinsic :: iso_c_binding, only: c_size_t
        integer(c_size_t), value :: qubit_id
        integer(c_size_t) :: outcome
    end function qdk_mz_reset
end interface
