"""__TITLE__

__DOC__
Exits 0 when the bug no longer reproduces.
Reproduces when __AFFECTED_TEXT__.
Exits 2 if affected rows were not tested and no tested row reproduces.

Requires: pip install qdk qirrunner__REQUIRES_EXTRA__
"""

import json
import os
import re
import sys
import tempfile

import qirrunner
from qdk import Context, TargetProfile

SOURCE = """__SOURCE__"""
__PROJECT_BLOCK__EXPECTED = "__EXPECTED__"  # the correct output
AFFECTED = __AFFECTED__  # runs that show the bug
SHOTS = 10
PROFILES = __PROFILES__


__BUILD__


def context(profile):
    """A Q# context for the profile, with the program loaded."""
    __CONTEXT__


def fmt(value):
    """Formats a simulator value the same way as qir-runner output below."""
    if value is None:
        return "()"
    if type(value).__name__ == "Result":
        return "1" if str(value).endswith("One") else "0"
    if isinstance(value, bool):
        return str(value).lower()
    if isinstance(value, float):
        return repr(value)
    if isinstance(value, (tuple, list)):
        inner = ", ".join(fmt(v) for v in value)
        return f"({inner})" if isinstance(value, tuple) else f"[{inner}]"
    return str(value)


def to_text(records):
    kind, value = next(records)
    if kind in ("TUPLE", "ARRAY"):
        inner = ", ".join(to_text(records) for _ in range(int(value)))
        return f"({inner})" if kind == "TUPLE" else f"[{inner}]"
    if kind == "DOUBLE":
        return repr(float(value))
    if kind == "BOOL":
        return value.lower()
    return value


def parse_shots(text):
    """Turns qir-runner's output records into one formatted value per shot."""
    shots, records = [], None
    for line in text.splitlines():
        fields = line.split("\t")
        if fields[0] == "START":
            records = []
        elif fields[0] == "OUTPUT" and records is not None:
            records.append((fields[1], fields[2]))
        elif fields[0] == "END" and records is not None:
            shots.append(to_text(iter(records)) if records else "()")
            if fields[1] != "0":
                shots[-1] = f"exit code {fields[1]}"
            records = None
    return shots


def run_qir(qir):
    with tempfile.NamedTemporaryFile("w", suffix=".ll", delete=False) as file:
        file.write(qir)
    handler = qirrunner.OutputHandler()
    try:
        qirrunner.run(file.name, shots=SHOTS, rng_seed=1, output_fn=handler.handle)
    except Exception as error:  # qir-runner rejects the module
        message = str(error).strip().splitlines()[0]
        if message.startswith("Failed to link"):  # valid QIR calling functions qir-runner lacks
            return {"qir-runner can't link: " + message.split(": ", 1)[-1]}
        return {"invalid QIR: " + re.sub(r"^\S+\.ll:\d+:\d+: (error: )?", "", message)}
    finally:
        os.unlink(file.name)
    return set(parse_shots(handler.get_output()))


def failure(error):
    """A compiler panic surfaces as PanicException, which derives from BaseException."""
    if isinstance(error, (KeyboardInterrupt, SystemExit)):
        raise error
    kind = "panics" if type(error).__name__ == "PanicException" else "does not compile"
    lines = [line.strip() for line in str(error).strip().splitlines() if line.strip()]
    message = lines[0] if lines else type(error).__name__
    causes = [line[3:].strip() for line in lines if line.startswith("`->")]
    if causes:  # a diagnostic's innermost cause, e.g. the failing check during partial evaluation
        message += ": " + causes[-1]
    return {f"{kind}: " + message}


def outputs():
    rows = {}
    for suffix, build in FORMS:
        try:
            ctx = context(TargetProfile.Unrestricted)
            entry, args = build(ctx)
            rows["simulator" + suffix] = {fmt(v) for v in ctx.run(entry, SHOTS, *args, seed=1)}
        except BaseException as error:
            rows["simulator" + suffix] = failure(error)
        for profile in PROFILES:
            try:
                ctx = context(getattr(TargetProfile, profile))
                entry, args = build(ctx)
                qir = str(ctx.compile(entry, *args))
            except BaseException as error:  # the profile rejects the program, or the compiler panics
                rows[profile + suffix] = failure(error)
                continue
            rows[profile + suffix] = run_qir(qir)
    return rows


def main():
    rows = outputs()
    width = max(map(len, rows)) + 2
    for name, values in rows.items():
        print(f"{name:<{width}}{' | '.join(sorted(values))}")
    print(f"{'expected':<{width}}{EXPECTED}")
    print("JSON: " + json.dumps({name: sorted(values) for name, values in rows.items()}))
    wrong = [name for name in AFFECTED if name in rows and rows[name] != {EXPECTED}]
    if wrong:
        print(f"REPRODUCED: {', '.join(wrong)} differ from {EXPECTED}")
        return 1
    missing = [name for name in AFFECTED if name not in rows]
    if missing:
        print(f"INCONCLUSIVE: affected rows not run: {', '.join(missing)}")
        return 2
    print("NOT REPRODUCED")
    return 0


if __name__ == "__main__":
    sys.exit(main())
